{
  "name": "rockbottom",
  "version": "1.0.0",
  "description": "RockBottom - Meme Execution Markets. Turn milestones into meme coins on X Layer.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon server/index.js\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "contracts:compile": "npx hardhat compile",
    "contracts:test": "npx hardhat test",
    "contracts:deploy:testnet": "npx hardhat run scripts/deploy.js --network xlayerTestnet",
    "contracts:deploy:mainnet": "npx hardhat run scripts/deploy.js --network xlayer",
    "generate:wallet": "node scripts/generate-wallet.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "sql.js": "^1.11.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "concurrently": "^9.1.0",
    "hardhat": "^2.22.17",
    "nodemon": "^3.1.7",
    "vite": "^6.0.6"
  }
}
